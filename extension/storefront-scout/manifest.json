{
  "manifest_version": 3,
  "name": "Source Stack Storefront Scout",
  "version": "0.4.2",
  "description": "Scan saved Amazon UK storefronts with checkpoints, bestsellers and product details.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.amazon.co.uk/*",
    "https://stockwise-roan-gamma.vercel.app/*"
  ],
  "action": {
    "default_title": "Open Storefront Scout"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
