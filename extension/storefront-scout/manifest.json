{
  "manifest_version": 3,
  "name": "Source Stack Storefront Scout",
  "version": "0.2.0",
  "description": "Scan saved Amazon UK storefronts with checkpoints, bestsellers and product details.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.amazon.co.uk/*",
    "https://stockwise-c8lq9p38s-rubbahead.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}