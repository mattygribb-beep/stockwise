{
  "manifest_version": 3,
  "name": "Flip Lead Amazon Scanner",
  "version": "0.1.0",
  "description": "Capture rendered Amazon UK storefront products for Flip Lead.",
  "permissions": [
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://www.amazon.co.uk/*"
  ],
  "action": {
    "default_title": "Flip Lead Amazon Scanner",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.uk/s*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}